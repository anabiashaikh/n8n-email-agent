    {
      "parameters": {
        "jsCode": "// Get all input items\nconst items = $input.all();\n\nconst output = items.map(item => {\n  let body = item.json.output.body;\n\n  // Split text into paragraphs based on double line breaks\n  body = body\n    .split(/\\n\\s*\\n/)\n    .map(p => p.trim())\n    .map(p => {\n      // Check if the paragraph contains bullets\n      if (p.includes('*')) {\n        // Split by * and remove empty strings\n        const items = p.split('*').filter(i => i.trim() !== '');\n        // Wrap each item in <li> and the whole list in <ul>\n        return `<ul>${items.map(i => `<li>${i.trim()}</li>`).join('')}</ul>`;\n      } else {\n        // Normal paragraph\n        return `<p>${p}</p>`;\n      }\n    })\n    .join('');\n\n  // Assign the formatted body back\n  item.json.output.body = body;\n\n  return item.json; // Return the full JSON for this item\n});\n{{ `Your first line\\n\\nYour second line\\n\\nAnabia Shaikh\\nBusiness Development Executive` }}\n\nreturn output;"
      },
